# Needed only for POST /incident/parse. Structured incidents work without it.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_TIMEOUT_SECONDS=30
# Needed only for POST /assistant/chat (the EvacRoute operations assistant). Never sent to
# or readable by the frontend.
GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-4
GROK_TIMEOUT_SECONDS=30
# Needed only for POST /incident/analyze-image (incident-photo analysis for the Report
# Incident form). Never sent to or readable by the frontend.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=30
# Public datasets are loaded from the committed processed file; ingestion is manual.
EVACROUTE_DATA_MODE=cached
# Optional for the Census PL API. Official TIGERweb POP100 works without a key.
CENSUS_API_KEY=
